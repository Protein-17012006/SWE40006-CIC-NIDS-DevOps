# Copy to .env for local runs. Every value here is a dummy.
APP_ENV=local
APP_VERSION=local
AWS_REGION=us-east-1
S3_BUCKET=
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cicnids
